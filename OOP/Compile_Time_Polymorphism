#include<cstdio>

class polygon
{
public:
int area(int x, int y)
{
return x*y;
}

int area(int x)
{
return x*x;
}

int area(float x, int y, int z)
{
return (x*y*z);
}
};

int main()
{
polygon poly;
printf("The area of rectangle is:");
printf("%d\n",poly.area(5,6));
printf("The area of square is:");
printf("%d\n",poly.area(7));
printf("The area of triangle is:");
printf("%d",poly.area(0.5,5,8));
return 0;
}




